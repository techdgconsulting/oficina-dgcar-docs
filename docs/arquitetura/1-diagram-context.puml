@startuml C4_Context_OficinaMecanica
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Diagrama de Contexto - Sistema Oficina Mecanica DGCar [C4 - Nivel 1]

' Visao ampla do sistema atual, incluindo API Gateway e Lambda Auth.

Person(atendente, "Atendente", "Perfil ATENDENTE. Cria OS, gera orcamentos, registra pagamentos, entrega veiculo, gerencia clientes e veiculos.")
Person(mecanico, "Mecanico", "Perfil MECANICO. Inicia diagnostico, adiciona itens de pecas/servicos e finaliza o servico.")
Person(gestor, "Gestor", "Perfil GESTOR. Acesso completo: operacoes da oficina, cadastros administrativos e KPIs.")
Person(cliente, "Cliente", "Proprietario do veiculo. Autentica com CPF e senha, recebe JWT CLIENTE e consulta a propria OS.")

System_Boundary(oficina, "Sistema Oficina Mecanica DGCar") {
  System(apiGateway, "Amazon API Gateway", "Entrada oficial para autenticacao externa e APIs protegidas.")
  System(lambdaAuth, "AWS Lambda Auth CPF + Senha", "Autentica cliente externo, consulta status/senha_hash e emite JWT CLIENTE.")
  System(api, "API Spring Boot no EKS", "Gerencia o ciclo completo da oficina e valida JWT interno/externo.")
  SystemDb(db, "Amazon RDS PostgreSQL", "Armazena clientes, usuarios, veiculos, OS, orcamentos, execucoes, pagamentos e entregas.")
}

System_Ext(viacep, "ViaCEP API", "Servico publico brasileiro para consulta de endereco por CEP.")
System_Ext(paymentGateway, "Gateway de Pagamento", "Processa e autoriza pagamentos. No projeto, a integracao e representada por adapter simulavel.")
System_Ext(smtpServer, "Servidor SMTP", "Infraestrutura externa usada para envio de e-mails quando OFICINA_EMAIL_MODE=SMTP.")
System_Ext(newRelic, "New Relic", "Observabilidade: logs, metricas, traces, dashboards e alertas.")

Rel(cliente, apiGateway, "Autentica por CPF/senha e consulta OS", "HTTPS/JSON")
Rel(atendente, apiGateway, "Opera clientes, veiculos, OS, orcamentos, pagamentos e entregas", "HTTPS/JSON + JWT interno")
Rel(mecanico, apiGateway, "Executa diagnostico e servicos", "HTTPS/JSON + JWT interno")
Rel(gestor, apiGateway, "Opera cadastros, KPIs e administracao", "HTTPS/JSON + JWT interno")

Rel(apiGateway, lambdaAuth, "POST /auth/cpf", "AWS_PROXY")
Rel(lambdaAuth, db, "Consulta cliente por documento, status_cliente e senha_hash", "SQL/TCP")
Rel(apiGateway, api, "Encaminha APIs protegidas", "HTTPS/JSON")
Rel(api, db, "Le e escreve dados da oficina", "SQL/TCP")

Rel(api, viacep, "Consulta endereco por CEP", "HTTP GET")
Rel(api, paymentGateway, "Envia valor e metodo; recebe aprovacao/recusa", "HTTPS")
Rel(api, smtpServer, "Envia notificacoes de orcamento e status da OS", "SMTP")
Rel(smtpServer, cliente, "Entrega e-mails", "E-mail")

Rel(apiGateway, newRelic, "Metricas e logs de entrada", "Telemetry")
Rel(lambdaAuth, newRelic, "Logs e metricas da autenticacao", "Telemetry")
Rel(api, newRelic, "Logs, metricas e traces da aplicacao", "Telemetry")

@enduml
