@startuml C4_Container_OficinaMecanica
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Diagrama de Container - Sistema Oficina Mecanica DGCar [C4 - Nivel 2]

' Visao dos principais containers e servicos da arquitetura atual.

Person(atendente, "Atendente", "Perfil ATENDENTE. Gerencia clientes, veiculos, OS, orcamentos e pagamentos.")
Person(mecanico, "Mecanico", "Perfil MECANICO. Inicia diagnostico, adiciona itens e finaliza servico.")
Person(gestor, "Gestor", "Perfil GESTOR. Acesso completo a operacoes, cadastros e KPIs.")
Person(cliente, "Cliente", "Autentica com CPF e senha e consulta a propria OS por numero.")

System_Ext(viacep, "ViaCEP API", "Servico publico para consulta de endereco por CEP.")
System_Ext(paymentGateway, "Gateway de Pagamento", "Processa e autoriza pagamentos. No projeto, a integracao e representada por adapter simulavel.")
System_Ext(smtpServer, "Servidor SMTP", "Envio de e-mails quando OFICINA_EMAIL_MODE=SMTP.")
System_Ext(newRelic, "New Relic", "Observabilidade centralizada.")

System_Boundary(oficina, "Sistema Oficina Mecanica") {
  Container(apiGateway, "Amazon API Gateway", "AWS API Gateway", "Entrada publica oficial. Roteia autenticacao externa e chamadas para a API.")
  Container(lambdaAuth, "Lambda Auth CPF + Senha", "Node.js 20.x, AWS Lambda", "Valida CPF, status_cliente e senha_hash; emite JWT externo tipo CLIENTE.")
  Container(api, "API Spring Boot", "Java 17, Spring Boot 3.5.16, Docker, EKS", "Expoe endpoints REST, executa casos de uso e valida JWT interno e JWT CLIENTE.")
  ContainerDb(db, "Amazon RDS PostgreSQL", "PostgreSQL 16", "Armazena clientes, usuarios, veiculos, OS, itens, pecas, servicos, orcamentos, execucoes, pagamentos, entregas e encerramentos.")
}

Rel(cliente, apiGateway, "POST /auth/cpf e consulta protegida de OS", "HTTPS/JSON")
Rel(atendente, apiGateway, "Operacoes da oficina", "HTTPS/JSON + JWT interno")
Rel(mecanico, apiGateway, "Operacoes de execucao e diagnostico", "HTTPS/JSON + JWT interno")
Rel(gestor, apiGateway, "Administracao e KPIs", "HTTPS/JSON + JWT interno")

Rel(apiGateway, lambdaAuth, "POST /auth/cpf", "AWS_PROXY")
Rel(lambdaAuth, db, "Consulta cliente por documento, status_cliente e senha_hash", "SQL/TCP 5432")
Rel(lambdaAuth, apiGateway, "Retorna JWT CLIENTE", "JSON")
Rel(apiGateway, api, "Encaminha rotas da aplicacao", "HTTPS/JSON")
Rel(api, db, "Le e escreve dados de dominio", "SQL/TCP 5432")

Rel(api, viacep, "Consulta endereco por CEP", "HTTP GET")
Rel(api, paymentGateway, "Processa pagamento", "HTTPS")
Rel(api, smtpServer, "Envia notificacoes", "SMTP")
Rel(smtpServer, cliente, "Entrega e-mails", "E-mail")

Rel(apiGateway, newRelic, "Metricas e logs", "Telemetry")
Rel(lambdaAuth, newRelic, "Logs e metricas", "Telemetry")
Rel(api, newRelic, "Logs, metricas e traces", "Telemetry")

@enduml
