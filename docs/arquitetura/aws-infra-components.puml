@startuml aws-infra-components
!theme plain
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor #1F2937
skinparam defaultTextAlignment center

left to right direction

title Componentes AWS Provisionados Por Terraform - Escopo De Infraestrutura

actor "Mantenedor / GitHub Actions" as maintainer

cloud "AWS" {
  database "Amazon S3\nTerraform State" as s3
  rectangle "IAM\nRoles e permissoes" as iam
  rectangle "Amazon ECR\nImagem Docker" as ecr
  rectangle "Amazon API Gateway\nEntrada oficial" as apigw
  rectangle "AWS Lambda\nAuth CPF + Senha\nNode.js 20.x" as lambda

  package "VPC" {
    rectangle "Subnets Publicas\nLoad Balancer / acesso EKS" as publicSubnets
    rectangle "Subnets Privadas\nEKS Nodes + RDS" as privateSubnets
    rectangle "Security Groups" as securityGroups

    rectangle "Amazon EKS\nCluster + Managed Node Group" as eks
    rectangle "Kubernetes\noficina-api + Service + HPA" as k8s
    database "Amazon RDS\nPostgreSQL 16" as rds
  }
}

maintainer --> s3 : cria/usa state remoto
maintainer --> iam : usa credenciais AWS
maintainer --> ecr : publica imagem
maintainer --> eks : provisiona cluster
maintainer --> apigw : provisiona rotas
maintainer --> lambda : publica pacote

s3 --> eks : Terraform state
s3 --> rds : Terraform state
s3 --> ecr : Terraform state
s3 --> apigw : Terraform state
s3 --> lambda : Terraform state

iam --> eks : permissoes
iam --> ecr : permissoes
iam --> apigw : permissoes
iam --> lambda : permissoes

apigw --> lambda : rota POST /auth/cpf
apigw --> k8s : rota proxy ANY /{proxy+}
lambda --> rds : acesso SQL 5432
ecr --> k8s : imagem da API
eks --> k8s : executa workloads
k8s --> rds : JDBC 5432

publicSubnets --> eks
publicSubnets --> k8s
privateSubnets --> k8s
privateSubnets --> rds
securityGroups --> eks
securityGroups --> rds
securityGroups --> lambda

note bottom
  Este diagrama mostra apenas os componentes AWS
  provisionados ou configurados por Terraform e pipelines:
  state remoto, IAM, ECR, API Gateway, Lambda, EKS,
  Kubernetes, subnets, security groups e RDS.

  Fluxos de usuarios, repositorios, CI/CD completo
  e New Relic ficam em cloud-target-architecture.puml.

  O S3 do state remoto e criado pelo bootstrap e destruido separadamente.
end note

@enduml
