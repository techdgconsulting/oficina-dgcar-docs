@startuml deploy-pipeline-flow
!theme plain
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam ArrowColor #1F2937
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  FontColor #111827
  DiamondBackgroundColor #ECFDF5
  DiamondBorderColor #047857
}

title Esteira De Deploy - Branches Protegidas, Homolog E Producao

start

partition "Desenvolvedor" {
  :Cria feature branch;
  :Abre Pull Request para homolog;
}

partition "CI / Pull Request Para Homolog" {
  :Executar testes automatizados;
  :Executar validacoes de build;
  :Executar validacoes de infraestrutura quando aplicavel;
  :Publicar resultado dos checks;
}

if (Checks aprovados?) then (sim)
  partition "Revisao Homolog" {
    :Revisao obrigatoria do Pull Request;
    :Resolver comentarios;
    :Merge em homolog;
  }
else (nao)
  :Bloquear merge;
  stop
endif

partition "Deploy Automatico Homolog" {
  :Push em homolog dispara workflow;
  :Carregar secrets e variaveis do environment homolog;
  :Build e publicacao de artefato;
  if (Repositorio?) then (API)
    :Build Maven e imagem Docker;
    :Push da imagem no ECR homolog;
    :Deploy da aplicacao no EKS homolog;
  elseif (Lambda)
    :Testes Node.js;
    :Empacotar Lambda;
    :Atualizar codigo da funcao em homolog;
  elseif (Infra DB)
    :Terraform apply do RDS homolog;
  else (Infra K8s)
    :Terraform apply de EKS, ECR, Gateway e manifests homolog;
  endif
  :Executar validacoes pos-deploy;
}

if (Homolog aprovado?) then (sim)
  partition "Promocao Para Producao" {
    :Abrir Pull Request de homolog para main;
    :Executar checks novamente;
    :Revisao e aprovacao obrigatoria;
    :Merge em main;
  }
else (nao)
  :Corrigir em nova feature branch e repetir ciclo;
  stop
endif

partition "Deploy Automatico Producao" {
  :Push em main dispara workflow;
  :GitHub Environment prod solicita aprovacao;
  :Aguardar aprovadores autorizados;
  :Carregar secrets e variaveis de prod;
  :Publicar artefato ou aplicar Terraform em prod;
  :Executar validacoes pos-deploy;
  :Registrar evidencias no GitHub Actions;
}

stop
@enduml
