@startuml deploy-pipeline-flow
!theme plain
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam ArrowColor #1F2937
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  FontColor #111827
  DiamondBackgroundColor #ECFDF5
  DiamondBorderColor #047857
}

title Esteira De Deploy - Validacoes, Aprovacoes E Promocao

start

partition "Desenvolvedor" {
  :Cria feature branch;
  :Abre Pull Request para homolog;
}

partition "CI / Pull Request" {
  :Executar testes automatizados;
  :Executar validacoes de build;
  :Executar validacoes de infraestrutura quando aplicavel;
  :Publicar resultado dos checks;
}

if (Checks aprovados?) then (sim)
  partition "Revisao" {
    :Revisar PR conforme regras de homolog;\nRevisao obrigatoria nao configurada nessa branch;
    :Resolver comentarios;
    :Merge em homolog;
  }
else (nao)
  :Corrigir a PR e repetir as validacoes;
  stop
endif

partition "Deploy Homolog" {
  if (Mudanca relevante para deploy?) then (sim)
    :Validar componente e solicitar atualizacao\nna fila central de homolog;
    :Coordenador despacha worker com\norchestrated, parent_run_id e source_sha;
    :Worker verifica SHA, branch, ambiente e execucao pai;\nCarregar secrets do environment homolog;
    if (Componente?) then (API)
      :Testar e gerar imagem Docker;\nPublicar no ECR;
      :Workflow da API cria configuracoes e workloads;\nAguardar rollout no EKS homolog;
    elseif (Lambda)
      :Testar Node.js e publicar infraestrutura/pacote\nconforme modalidade solicitada;
    elseif (Infra DB)
      :Validar e salvar plano do RDS;\nBloquear remocao, substituicao ou plano incompleto;\nAplicar exatamente o plano validado;
    else (Infra K8s)
      :Exigir ambiente e integracoes existentes;\nValidar e salvar plano da plataforma;\nBloquear alteracoes destrutivas e aplicar plano;
    endif
    :Conferir resultado do worker e evidencias do componente;
  else (nao)
    :README, Postman e documentacao:\nsem apply ou deploy;
  endif
}

if (Homolog aprovado?) then (sim)
  partition "Promocao Para Producao" {
    :Abrir PR de promocao para main;\nBranch de release deve preservar historico de homolog;
    :Executar checks e verificar historico de homolog;
    :Main protegida, inclusive para administradores;\nExigir uma aprovacao de outra conta;
    :Squash and merge em main;\nSem commits diretos;
  }
else (nao)
  :Corrigir em nova branch e repetir ciclo;
  stop
endif

partition "Deploy Producao" {
  if (Mudanca relevante para deploy?) then (sim)
    :Validar e enviar pedido a fila central de prod;
    if (Environment exige aprovacao?) then (sim)
      :Aguardar aprovacao do environment;\nControle separado da revisao da PR;
    endif
    :Autorizar worker, commit e execucao pai;\nCarregar secrets e variaveis de prod;
    :Executar componente com o SHA validado de main;\nMesmas responsabilidades e protecoes de homolog;
    :Registrar resultado e evidencias no GitHub Actions;
  else (nao)
    :Atualizacao documental sem apply ou deploy;
  endif
}

:Fila unica por ambiente para atualizacoes,\nprovisionamento, manutencao e destroy;\nNao cancela execucao ativa nem garante ordem cronologica;
:Ambiente ausente exige provisionamento completo manual;\nAtualizacao isolada nao recria o ambiente;

stop
@enduml
