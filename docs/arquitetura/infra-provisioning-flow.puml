@startuml infra-provisioning-flow
!theme plain
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam ArrowColor #1F2937
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  FontColor #111827
  DiamondBackgroundColor #EEF2FF
  DiamondBorderColor #4338CA
}

title Provisionamento E Teardown Da Infraestrutura - Homolog E Producao

start

partition "Mantenedor" {
  :Seleciona workflow no repositorio oficina-dgcar-infra-k8s;
  :Ambiente definido pelo workflow selecionado;\nNao existe input environment;
  if (Ambiente?) then (homolog)
    :Provisionar Ambiente Homolog: branch homolog;\ncomponent=all e confirm=PROVISIONAR;
    :Destruir Ambiente Homolog: confirm=DESTRUIR;\nBranch homolog ou main aceita pelo workflow;
  else (prod)
    :Provisionar Ambiente Prod: branch main;\ncomponent=all e confirm=PROVISIONAR_PROD;
    :Destruir Ambiente Prod: branch main;\nconfirm=DESTRUIR_PROD;
  endif
  :Acionar somente o workflow da operacao desejada;\nProvisionamento completo e destroy sao manuais;
}

:Aguardar fila compartilhada do ambiente;\nSem cancelar execucao ativa;\nSem garantia de ordem cronologica;

partition "GitHub Environment" {
  if (Ambiente exige aprovacao?) then (sim)
    :Aguardar aprovadores do environment;
  else (nao)
    :Seguir com regras do environment;
  endif
  :Carregar secrets e variaveis do ambiente selecionado;
}

partition "Preflight" {
  :Validar identidade AWS;
  :Validar secrets obrigatorios;
  :Validar lock/backend Terraform;
}

if (Operacao selecionada?) then (PROVISIONAR)
  partition "Infra K8s / Gateway" {
    :Inicializar backend S3;
    :Validar recursos residuais conflitantes;\nTratar node group em falha quando aplicavel;
    :Salvar plano e validar ausencia de remocoes/substituicoes;\nAplicar exatamente o plano validado;
    :Provisionar VPC, subnets, EKS, ECR,\nAPI Gateway base e observabilidade New Relic;
    :Publicar outputs de rede, cluster e registry\nnos environments dependentes;
  }

  partition "Infra DB" {
    :Coordenador despacha worker na branch do ambiente\ncom orchestrated, parent_run_id e source_sha;
    :Worker autoriza origem antes de acessar AWS;\nValidar plano salvo e provisionar PostgreSQL;
    :Publicar outputs de endpoint, porta, database e security group;
  }

  partition "Lambda Auth" {
    :Acionar provisionamento da Lambda Auth CPF + Senha;
    :Publicar security group da Lambda;\nReaplicar banco e validar acesso ao PostgreSQL;
    :Publicar pacote da Lambda;
  }

  partition "Integracoes" {
    :Integrar POST /auth/cpf no API Gateway;
    :Publicar URL do Gateway como OFICINA_PUBLIC_BASE_URL;\nAutorizar acesso do GitHub Actions ao EKS;
    :Acionar worker da API na branch do ambiente;\nTestar, publicar imagem no ECR e aplicar workloads no EKS;
    :Resolver endpoint da aplicacao;
    :Integrar rota proxy ANY /{proxy+} no API Gateway;
    :Validar outputs finais;
  }

  if (Smoke tests habilitados?) then (sim)
    :Executar login CPF + senha;
    :Validar JWT CLIENTE;
    :Consultar OS por numero com Bearer token;
    :Validar bloqueios sem token e fora do CPF autenticado;
  else (nao)
    :Smoke tests desabilitados por padrao;\nConferir funcionamento separadamente;
  endif

else (DESTROY)
  partition "Teardown Coordenado" {
    :Remover workloads Kubernetes e LoadBalancers;
    :Retirar integracoes dependentes do API Gateway;
    :Preparar banco com plano completo validado;\nDesativar protecao de exclusao em prod;
    :Destruir PostgreSQL sem snapshot final;\nLimpar snapshots manuais e backups retidos\nda instancia exata do ambiente;
    :Destruir Lambda Auth CPF + Senha;
    :Aguardar liberacao de ENIs gerenciadas;
    :Remover dependencias residuais seguras da VPC;
    :Destruir API Gateway, EKS, ECR,\nobservabilidade, rede e IAM do ambiente;
    :Executar diagnostico adicional quando houver dependencia residual;
    :Validar ausencia dos recursos e dos backups do RDS;\nFalhar se houver residuos;
    :Backend S3 compartilhado do Terraform\npermanece fora do destroy dos ambientes;
  }
endif

stop
@enduml
